<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <add key="OverloadKw" value="7.0"/>

    <add key="FreqSpikeHz" value="0.3"/>

    <add key="FreqDeviationHz" value="0.5"/>

    <add key="NominalFreqHz" value="60"/>

    <add key="StallWindow" value="10"/>

    <add key="StallEpsKWh" value="0.0001"/>

    <add key="ConsoleCsvDump" value="false"/>
  </appSettings>

  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="StreamedTcp"
                 transferMode="Streamed"
                 maxReceivedMessageSize="2147483647"
                 maxBufferSize="65536"
                 receiveTimeout="00:10:00"
                 sendTimeout="00:10:00">
          <security mode="None"/>
        </binding>
      </netTcpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="svc">
          <serviceMetadata/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <services>
      <service name="Service.Services.ChargingService" behaviorConfiguration="svc">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:9001/"/>
          </baseAddresses>
        </host>

        <endpoint address="ChargingService"
                  binding="netTcpBinding"
                  bindingConfiguration="StreamedTcp"
                  contract="Common.IChargingService"/>

        <endpoint address="mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange"/>
      </service>
    </services>
  </system.serviceModel>
</configuration>
